# --- Companies House (UK account filings) ---
# Register an application at https://developer.company-information.service.gov.uk/
# and create a REST API key ("Live" application). Used as the Basic-auth username.
COMPANIES_HOUSE_API_KEY=

# --- Claude review of filings ---
# https://console.anthropic.com/settings/keys — optional: without it the app
# still searches and downloads filing PDFs, it just cannot review them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000

# --- CORS ---
# Comma-separated list of allowed browser origins (no brackets, no quotes).
# Example for prod: CORS_ORIGINS=https://financial-overview.vercel.app
CORS_ORIGINS=http://localhost:3000
